<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fiche de Course"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- Titre et drapeau -->
    <TextView
        android:id="@+id/tv_race_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Titre de la course"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="10dp" />

    <!-- Circuit et pays -->
    <TextView
        android:id="@+id/tv_circuit_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Circuit"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <!-- Dates -->
    <TextView
        android:id="@+id/tv_race_dates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dates"
        android:textSize="16sp"
        android:layout_marginBottom="20dp" />

    <!-- Résultats / Sessions -->
    <TextView
        android:id="@+id/tv_race_results"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chargement des données du GP..."
        android:textSize="15sp"
        android:layout_marginBottom="30dp" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Retour"
        android:onClick="clicBack" />

</LinearLayout>