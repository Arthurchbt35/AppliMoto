<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="Classement MotoGP 2026"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Boutons de filtre Pilotes / Équipes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_pilotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:onClick="clicPilotes"
            android:text="Pilotes" />

        <Button
            android:id="@+id/btn_equipes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:onClick="clicEquipes"
            android:text="Équipes" />
    </LinearLayout>

    <!-- En-tête du tableau -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#D4D5D5"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:text="POS"
            android:textColor="#1C1C1C"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_header_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PILOTE"
            android:textColor="#1C1C1C"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="55dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="VIC."
            android:textColor="#1C1C1C"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="POINTS"
            android:textColor="#1C1C1C"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Liste déroulante du classement -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/container_standing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:onClick="clicBack"
        android:text="Retour" />

</LinearLayout>